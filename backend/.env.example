# PostgreSQL / Supabase
DB_HOST="your-supabase-pooler-host"
DB_PORT="5432"
DB_NAME="postgres"
DB_USER="postgres.your-project-ref"
DB_PASSWORD="your-db-password"

# App
ENVIRONMENT="dev"
LOG_LEVEL="INFO"

# Ingestion mode: false = fast (no enrichment), true = enriched (AUM, expense ratio, etc.) ~1hr
MF_ENRICHMENT_ENABLED="false"

# Pipeline
PIPELINE_TRIGGER_API_KEY="your-api-key"
